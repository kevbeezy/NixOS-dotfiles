[global]
    padding = 5
    horizontal_padding = 5
    gap_size = 3
    transparency = 35
    frame_width = 4
    corner_radius = 0
    font = JetBrainsMono Nerd Font 10
    format = "<b>%s</b>\n%b"
    origin = top-right
    min_icon_size = 32
    max_icon_size = 32
    offset = (10, 10)
    width = (0,300)
    height = (0,300)
    foreground = "#ebdbb2"
    background = "#282828"
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_all

[urgency_low]
    frame_color = "#b8bb26"
    timeout = 3

[urgency_normal]
    frame_color = "#C66B25"
    timeout = 5

[urgency_critical]
    frame_color = "#fb4934"
    timeout = 0

[logger]
    summary = "*"
    script = ~/.config/dunst/logger.sh
